# StarLearn — AI 代理配置
# 复制为 .env（本地）或 /etc/techlearn/ai.env（生产），不要提交真实密钥。

# OpenAI 兼容 API 根地址；也可填完整的 .../chat/completions 地址
AI_API_BASE=https://api.deepseek.com/v1
# DeepSeek / OpenAI 等云端服务需要；本地 Ollama、llama.cpp 可留空
AI_API_KEY=
AI_MODEL=deepseek-chat

# 静态站点目录。Docker 内为 /app/dist；本机从项目根目录运行时为 ./dist
SITE_DIR=./dist
HOST=127.0.0.1
PORT=8080

# 上游超时（秒）与最大输出 Token
AI_TIMEOUT=90
AI_MAX_TOKENS=1200

# 每个 IP 每分钟最多请求数
RATE_LIMIT=20

# 仅当需要从其他域名调用代理时设置；同源部署保持为空
CORS_ORIGIN=
